# ═══════════════════════════════════════════════════════════════
# RCC-HIROS — production environment
# Copy to .env.production next to docker-compose.yml (never commit it).
#   cp .env.production.example .env.production
# Generate secrets with: openssl rand -base64 48
# ═══════════════════════════════════════════════════════════════

# ── Application ──
# Inside compose the database host is the service name `db`.
DATABASE_URL="mysql://hiros:CHANGE_ME_DB_PASSWORD@db:3306/rcc_hiros"
JWT_SECRET="CHANGE_ME_RANDOM_48_BYTES"
TZ="Asia/Manila"

# Server-side address of the ZK bridge. In Docker, the Windows host.
KIOSK_SERVICE_URL="http://host.docker.internal:8765"

# Browser-side address, baked into the client bundle at build time.
# Kiosk PCs serve the app from 127.0.0.1, so this stays loopback.
NEXT_PUBLIC_KIOSK_SERVICE_URL="http://127.0.0.1:8765"

# ── Database (mariadb:11.4 image) ──
MARIADB_ROOT_PASSWORD="CHANGE_ME_ROOT_PASSWORD"
MARIADB_DATABASE="rcc_hiros"
MARIADB_USER="hiros"
MARIADB_PASSWORD="CHANGE_ME_DB_PASSWORD"

# ── Cloudflare Tunnel (profile: tunnel) ──
# Dashboard → Zero Trust → Networks → Tunnels → create → install token.
# Leave empty while using the throwaway `quick` profile.
CLOUDFLARE_TUNNEL_TOKEN=""

# ── Optional overrides ──
# Pin a previous build for rollback:
# APP_IMAGE="ghcr.io/sfrussel/rcc-hiros-russel:<git-sha>"
