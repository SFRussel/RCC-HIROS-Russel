# RCC-HIROS Environment Variables
# Copy this file to .env for local development and fill in your values.
# NEVER commit .env to git — it's in .gitignore.

# MySQL / MariaDB connection string, read at runtime by Prisma.
# Local dev (XAMPP):   mysql://root:@localhost:3306/rcc_hiros
# Docker compose:      mysql://hiros:secret@db:3306/rcc_hiros
# Compose publishes the database on 127.0.0.1:3307 if you run the app
# locally against the containerised database.
DATABASE_URL="mysql://root:@localhost:3306/rcc_hiros"

# Strong random secret for JWT signing (required)
# Generate with: openssl rand -base64 64
JWT_SECRET="change-me-to-a-random-secret"

# ZK Kiosk Fingerprint Service — browser-side address (baked at build time).
# Kiosk browsers run on the machine with the scanner, so loopback is correct.
NEXT_PUBLIC_KIOSK_SERVICE_URL="http://127.0.0.1:8765"

# Optional: server-side address used by the API routes for 1:N matching.
# Leave unset locally; set to http://host.docker.internal:8765 in Docker.
# KIOSK_SERVICE_URL="http://127.0.0.1:8765"
